# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Required if using Google Maps Platform JS & Geocoding
# Leave blank to use Leaflet & OpenStreetMap tiles default provider
VITE_GOOGLE_MAPS_API_KEY=""

# PAYMOB_API_KEY: Paymob Egypt integration secret API key for online card payments
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""

# FAWRY_MERCHANT_CODE: Fawry Egypt merchant code and security key
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""

# JWT_SECRET: Secret for signing session tokens
JWT_SECRET="waselha_egypt_super_secret_jwt_key_2026"

# SMS Misr Gateway Configuration
# Set SMS_MISR_ENVIRONMENT="production" to send live SMS via SMS Misr in production
SMS_MISR_ENVIRONMENT="development"
SMS_MISR_USERNAME="your_sms_misr_username"
SMS_MISR_PASSWORD="your_sms_misr_password"
SMS_MISR_SENDER="Waselha"

